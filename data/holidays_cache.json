White;font-size:18px;width:100%;border-collapse:collapse;\">\n              <tbody>\n                <tr>\n                  <td style=\"color:White;font-size:18px;font-style:italic;width:15%;\">\n                    <a href=\"javascript:__doPostBack('ctl00$ContentPlaceHolder3$cal1','V9709')\" style=\"color:White\" title=\"Go to the previous month\">&lt;</a>\n                  </td>\n                  <td align=\"center\" style=\"width:70%;\">September 2026</td>\n                  <td align=\"right\" style=\"color:White;font-size:18px;font-style:italic;width:15%;\">\n                    <a href=\"javascript:__doPostBack('ctl00$ContentPlaceHolder3$cal1','V9770')\" style=\"color:White\" title=\"Go to the next month\">&gt;</a>\n                  </td>\n                </tr>\n              </tbody>\n            </table>\n          </td>\n        </tr>\n        <tr>\n          <th align=\"center\" abbr=\"Monday\" scope=\"col\" style=\"color:#DDDDDD;background-color:#425FE1;\">Mon</th>\n          <th align=\"center\" abbr=\"Tuesday\" scope=\"col\" style=\"color:#DDDDDD;background-color:#425FE1;\">Tue</th>\n          <th align=\"center\" abbr=\"Wednesday\" scope=\"col\" style=\"color:#DDDDDD;background-color:#425FE1;\">Wed</th>\n          <th align=\"center\" abbr=\"Thursday\" scope=\"col\" style=\"color:#DDDDDD;background-color:#425FE1;\">Thu</th>\n          <th align=\"center\" abbr=\"Friday\" scope=\"col\" style=\"color:#DDDDDD;background-color:#425FE1;\">Fri</th>\n          <th align=\"center\" abbr=\"Saturday\" scope=\"col\" style=\"color:#DDDDDD;background-color:#425FE1;\">Sat</th>\n          <th align=\"center\" abbr=\"Sunday\" scope=\"col\" style=\"color:#DDDDDD;background-color:#425FE1;\">Sun</th>\n        </tr>\n        <tr>\n          <!-- Aug 31 \u2014 trailing day from previous month, YellowGreen text -->\n          <td align=\"center\" style=\"color:YellowGreen;border-color:#CCCCCC;border-width:1px;border-style:solid;font-style:italic;width:14%;\">31</td>\n  