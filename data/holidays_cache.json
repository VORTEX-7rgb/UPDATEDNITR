id;font-weight:bold;width:14%;\">27</td>\n        </tr>\n        <tr>\n          <td align=\"center\" style=\"border-color:#CCCCCC;border-width:1px;border-style:solid;width:14%;\">28</td>\n          <td align=\"center\" style=\"border-color:#CCCCCC;border-width:1px;border-style:solid;width:14%;\">29</td>\n          <td align=\"center\" style=\"border-color:#CCCCCC;border-width:1px;border-style:solid;width:14%;\">30</td>\n          <!-- TRAILING HOLIDAY: Oct 2 \u2014 Gandhi Jayanti, on the September grid -->\n          <td title=\"Mahatma Gandhis Birthday\" align=\"center\" style=\"color:#FFFFFF;background-color:#D9534F;border-color:#D43F3A;border-width:1px;border-style:solid;width:14%;\">2</td>\n          <td align=\"center\" style=\"color:YellowGreen;border-color:#CCCCCC;border-width:1px;border-style:solid;font-style:italic;width:14%;\">3</td>\n          <td align=\"center\" style=\"color:YellowGreen;border-color:#CCCCCC;border-width:1px;border-style:solid;font-style:italic;width:14%;\">4</td>\n          <td align=\"center\" style=\"color:YellowGreen;border-color:#CCCCCC;border-width:1px;border-style:solid;font-style:italic;width:14%;\">5</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n\n</form>\n</body>\n</html>\n"
