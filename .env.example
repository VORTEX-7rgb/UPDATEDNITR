# ════════════════════════════════════════════════════════════════════
# collegeclaw — ENV IS THE SINGLE SOURCE OF TRUTH for every tunable.
# Every value below shows its DEFAULT; unset = default behavior.
# ════════════════════════════════════════════════════════════════════

# ── Telegram & NITRIS Core ──────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
NITRIS_BASE_URL=https://eapplication.nitrkl.ac.in
# 32-byte URL-safe base64 Fernet encryption key
ENCRYPTION_KEY=generate_fernet_key_here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/collegeclaw
# Postgres connection pool sizing (per process). Defaults 10/20; launch tuning
# uses 20/30 (~50 conns, headroom under PG default max_connections=100).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Debounce window (seconds) for emergency engine-pool disposal during DB blips.
DB_POOL_DISPOSE_DEBOUNCE_SECONDS=60

# ── Question Paper Storage Channel ─────────────────────────────────
# Private Telegram storage channel/group ID where papers are uploaded once.
QP_STORAGE_CHAT_ID=0

# ── Admin Telegram IDs ──────────────────────────────────────────────
# Comma-separated list of Telegram user IDs authorized for /status and /admin_reset_qp
ADMIN_TELEGRAM_IDS=123456789,987654321

# ── NITRIS Gateway & Concurrency Limiting ───────────────────────────
NITRIS_GATEWAY_MAX_CONCURRENT=8
NITRIS_GATEWAY_MIN_LOGIN_INTERVAL=1.5
NITRIS_LOGIN_BURST=3
NITRIS_GATEWAY_CIRCUIT_ERROR_THRESHOLD=10
NITRIS_GATEWAY_CIRCUIT_RECOVERY_SECONDS=60
# Background work leaves this many slots free for interactive taps.
NITRIS_RESERVED_INTERACTIVE_SLOTS=2
# Cooldown before a failed credential may retry logging in.
NITRIS_CREDENTIAL_COOLDOWN_SECONDS=3600
NITRIS_JOB_WORKERS=16
# Interactive lane must cover the gateway's slot count so simultaneous taps
# never queue on worker availability while slots sit idle.
NITRIS_INTERACTIVE_WORKERS=8
NITRIS_JOB_QUEUE_MAX_DEPTH=200
# Max concurrent user registrations (each = NITRIS login + attendance fetch).
REGISTRATION_MAX_CONCURRENT=4
QP_METADATA_MAX_CONCURRENT=3
JOB_MAX_RETRIES=3
JOB_RETRY_BASE_DELAY=2.0
INBOX_DETAIL_FETCH_CONCURRENCY=5
INBOX_BODY_TTL_SECONDS=1800

# ── NITRIS Session Pool (per-user authenticated clients) ───────────
NITRIS_SESSION_TTL_SECONDS=1800
NITRIS_SESSION_POOL_MAX=256

# ── NITRIS Client HTTP Behavior ─────────────────────────────────────
# Per-request timeout applied to every portal call (seconds).
NITRIS_HTTP_TIMEOUT_SECONDS=30
# Resolved module-URL cache + year/session probe-hint lifetimes (seconds).
# URL cache aligned to session TTL (1800); fast-path hits refresh entries.
NITRIS_URL_CACHE_TTL_SECONDS=1800
NITRIS_PROBE_HINT_TTL_SECONDS=2700

# ── Per-Module Background Sync TTLs (in seconds) ───────────────────
MODULE_TTL_ATTENDANCE=43200
MODULE_TTL_INBOX=14400
MODULE_TTL_TIMETABLE=604800

# ── Durable Scheduler Settings ──────────────────────────────────────
SCHEDULER_BATCH_SIZE=25
# 10s keeps background freshness tight; the claim query is cheap+indexed and
# queue-depth backpressure protects against herds.
SCHEDULER_POLL_INTERVAL=10
SCHEDULER_CLAIM_STALE_SECONDS=300
SCHEDULER_MAX_QUEUE_DEPTH=50
DISPATCH_BATCH_SIZE=600
DISPATCH_CLAIM_STALE_SECONDS=300
DISPATCH_MAX_ATTEMPTS=5
# 2s idle poll — notifications land fast; drain-mode removes the interval
# entirely while a backlog exists.
DISPATCH_INTERVAL_SECONDS=2
DISPATCH_REAPER_INTERVAL_SECONDS=60
DISPATCH_SEND_TIMEOUT_SECONDS=30
DISPATCH_FLOODWAIT_MAX_RETRIES=3
# 0.035s pacing ≈ ~28 msg/s (< Telegram's ~30 msg/s ceiling).
DISPATCH_PACING_SECONDS=0.035

# ── Question-Paper Cache Service (mirrors ATTACHMENT_* below) ──────
QP_MAX_CONCURRENT_ACQUISITIONS=8
QP_MAX_CONCURRENT_DELIVERIES=25
QP_ACQUIRE_STALE_SECONDS=300
QP_PERMANENT_AFTER=5
QP_WAIT_POLL_INTERVAL_SECONDS=2.0
QP_WAIT_TIMEOUT_SECONDS=60.0
QP_FLOODWAIT_MAX_RETRIES=3
QP_DELIVERY_MAX_RETRIES=3
QP_DELIVERY_RETRY_BASE_DELAY=1.0

# ── Attachment Cache Service ────────────────────────────────────────
ATTACHMENT_CACHE_STALE_SECONDS=300
ATTACHMENT_CACHE_PERMANENT_AFTER=5
ATTACHMENT_MAX_CONCURRENT_ACQUISITIONS=8
ATTACHMENT_MAX_CONCURRENT_DELIVERIES=25
ATTACHMENT_WAIT_POLL_INTERVAL=2.0
ATTACHMENT_WAIT_TIMEOUT=60.0
ATTACHMENT_FLOODWAIT_MAX_RETRIES=3
ATTACHMENT_DELIVERY_MAX_RETRIES=3
ATTACHMENT_DELIVERY_RETRY_BASE_DELAY=1.0
ATTACHMENT_STORAGE_CHAT_ID=

# ── Retention Sweeper (bounds snapshots + events tables) ───────────
# How often the sweeper runs (seconds). 21600 = 6h.
RETENTION_INTERVAL_SECONDS=21600
# Newest N snapshots kept per (user_id, module_name); older ones purged.
RETENTION_SNAPSHOT_KEEP=10
# Terminal (sent/permanently-failed) events older than this are purged (days).
RETENTION_EVENT_DAYS=14
# Rows deleted per short transaction — keeps locks brief, autovacuum happy.
RETENTION_DELETE_BATCH=5000
# Pause between delete batches (seconds).
RETENTION_BATCH_PAUSE_SECONDS=0.5

# ── Per-User Operation Cooldowns (anti-spam UX guards) ─────────────
COOLDOWN_ATTENDANCE_REFRESH=60
COOLDOWN_INBOX_REFRESH=60
COOLDOWN_ATTACHMENT_DOWNLOAD=10
COOLDOWN_PAPERS_SEARCH=10
RATE_LIMITER_PRUNE_EVERY=256
COOLDOWN_TIMETABLE_SYNC=60

# ── Broadcast & UX Timings ──────────────────────────────────────────
BROADCAST_MAX_RETRIES=3
BROADCAST_PACING_SECONDS=0.05
BROADCAST_PROGRESS_EVERY=250
ATTENDANCE_SLOW_AFTER_SECONDS=3.5
TIMETABLE_LOOKAHEAD_DAYS=7
TIMETABLE_CLASS_END_GRACE_MIN=2

# ── Pre-warm (admin-driven QP cache filling) ─────────────────────────
# Max subjects per /admin_prewarm run (each = mid+end papers).
PREWARM_MAX_ITEMS=300

# ── Debug Mode ──────────────────────────────────────────────────────
# DEBUG=true dumps full NITRIS HTML (student PII) to disk. The bot REFUSES to
# boot with DEBUG=true unless you also set ALLOW_DEBUG_IN_PROD=1.
DEBUG=false
ALLOW_DEBUG_IN_PROD=
