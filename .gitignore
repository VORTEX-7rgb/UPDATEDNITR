# ── Environment & Secrets (NEVER COMMIT SECRETS) ───────────────────
.env
*.env
.env.local
.env.development
.env.production
!.env.example

# ── Python Cache & Bytecode ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# ── Virtual Environments ────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── IDE & Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Debug, Logs & Temporary Files ───────────────────────────────────
debug_html/
*.log
*.tmp
*.bak
memory/
*RECON*.json
*recon*.json
scratch_*.py

# ── Local Persistent Caches ─────────────────────────────────────────
data/*.json